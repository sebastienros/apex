<Project>
  <PropertyGroup>
    <PackageIconProject Condition="'$(PackageIconProject)' == ''">$(MSBuildProjectName)</PackageIconProject>
  </PropertyGroup>
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)assets/$(PackageIconProject)/icon.png"
          Pack="true"
          PackagePath="\"
          Link="icon.png" />
  </ItemGroup>
</Project>
