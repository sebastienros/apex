<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
    <Description>Optional asynchronous ADO.NET adapters for Apex direct SQL clients.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageIconProject>Apex.SqlClient</PackageIconProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apex.SqlClient\Apex.SqlClient.csproj" />
  </ItemGroup>
</Project>
