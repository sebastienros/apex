<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
    <Description>Optional asynchronous PostgreSQL ADO.NET adapter for Apex.PgClient.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <PackageIconProject>Apex.PgClient</PackageIconProject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apex.SqlClient.AdoNet\Apex.SqlClient.AdoNet.csproj" />
    <ProjectReference Include="..\Apex.PgClient\Apex.PgClient.csproj" />
  </ItemGroup>
</Project>
