<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Apex.MsSqlClient\Apex.MsSqlClient.csproj" />
    <ProjectReference Include="..\Apex.MySqlClient\Apex.MySqlClient.csproj" />
    <ProjectReference Include="..\Apex.PgClient\Apex.PgClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Core" />
    <PackageReference Include="Azure.Identity" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Features Condition="'$(TargetFramework)' == 'net11.0'">runtime-async=on</Features>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Microsoft Entra authentication for Apex drivers</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
